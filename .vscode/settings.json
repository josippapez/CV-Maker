{
  "i18n-ally.localesPaths": [
    "modules/ErrorPage/i18n",
    "modules/LandingPage/i18n",
    "modules/Navbar/i18n",
    "modules/NotFound/i18n",
    "modules/PDFPreview/i18n",
    "modules/PDFView/i18n",
    "modules/PDFView/CVTemplates/i18n",
    "modules/PDFView/PDFInputs/i18n",
    "modules/PDFView/PDFTabNavigation/i18n",
    "modules/PDFView/VersionHistory/i18n",
    "modules/Shared/DatePicker/i18n"
  ],
  "i18n-ally.autoDetection": true,
  "i18n-ally.dirStructure": "auto",
  "i18n-ally.enabledFrameworks": ["next-intl"],
  "i18n-ally.enabledParsers": ["js", "json"],
  "i18n-ally.namespace": true,
  "i18n-ally.pathMatcher": "{locale}.{ext}",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.translate.engines": ["google"],
  "i18n-ally.translate.parallels": 5,
  "i18n-ally.annotations": true,
  "i18n-ally.theme.annotation": "rgba(153, 153, 153, .8)",
  "i18n-ally.theme.annotationBorder": "rgba(153, 153, 153, .8)",
  "i18n-ally.theme.annotationMissing": "#d37070",
  "i18n-ally.theme.annotationMissingBorder": "#d37070",
  "i18n-ally.displayLanguage": "en-US",
  "i18n-ally.sourceLanguage": "en-US",
  "typescript.tsdk": "node_modules\\typescript\\lib",
  "tailwindCSS.classAttributes": ["class", "className", "ngClass"],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ]
}
